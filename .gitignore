# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Anki addon runtime artefacts (managed by Anki, not source)
meta.json
user_files/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Build artefacts
*.ankiaddon
build/
dist/

# Tooling state (worktrees, local caches) - but track the shared project settings
.claude/*
!.claude/settings.json

# Local-only publishing notes (working-tree only, never ship)
theankidote-publishing-instructions.txt
*-publishing-instructions.txt

# Review tooling, never part of a release
.ruff_cache/
.pytest_cache/
